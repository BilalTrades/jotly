{
  "name": "jotly",
  "version": "1.0.0",
  "description": "jotly — 100% free, offline-first desktop trading journal by Bilal_tradess",
  "author": "Bilal_tradess",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tauri build",
    "frontend:build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "tauri dev",
    "portable": "tauri build --no-bundle && node scripts/make-portable.mjs",
    "package:windows": "tauri build --bundles nsis,msi",
    "tauri": "tauri",
    "test": "tsx --test tests/core.test.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@fontsource/plus-jakarta-sans": "^5.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
